# Copy to .env (never committed) for local development, and set the same
# variables in Vercel -> Project -> Settings -> Environment Variables.
# Everything is optional: without a value the app uses its local fallback.

# Database (Neon via Vercel Marketplace sets DATABASE_URL / POSTGRES_URL automatically)
DATABASE_URL=

# Vercel Blob (Storage tab -> Blob; set automatically when the store is connected)
BLOB_READ_WRITE_TOKEN=

# Clerk (dashboard -> API keys). Issuer = "Frontend API URL", e.g. https://xxx.clerk.accounts.dev
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=https://your-app.vercel.app
VITE_CLERK_PUBLISHABLE_KEY=

# Muse Spark (Meta Model API, OpenAI-compatible)
MUSE_API_KEY=
MUSE_API_BASE=
MUSE_MODEL=

# SAM 3.1 hosted endpoint (site photo check)
SAM_API_KEY=
SAM_API_BASE=
SAM_MODEL=
